{
  "name": "sudoku-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fixtures:hints": "node scripts/split-hint-plans.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "test:catalog": "vitest run src/i18n/catalogs.test.ts src/i18n/backendMessages.test.ts",
    "test:contract": "vitest run src/i18n/backendHintContract.test.ts",
    "test:bundle": "node scripts/check-locale-bundles.mjs",
    "test:docs": "python3 scripts/validate_aidoc.py && python3 -m unittest scripts/test_validate_aidoc.py",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "test:e2e:interaction-regression": "playwright test --grep 'preserves immediate 1, 2, 3 candidate edits' --repeat-each=3 --workers=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:deployment": "node scripts/check-deployment.mjs",
    "test:release": "node scripts/package-release.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intl": "^7.1.14"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^2.11.4",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "description": "Responsive web client for the authoritative Sudoku HTTP API"
}
